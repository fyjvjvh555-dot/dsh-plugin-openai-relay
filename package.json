  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openai",
    "relay",
    "provider",
    "gpt",
    "image-generation",
    "apikey-fan"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyjvjvh555-dot/dsh-plugin-openai-relay.git"
  },
  "homepage": "https://github.com/fyjvjvh555-dot/dsh-plugin-openai-relay#readme",
  "bugs": {
    "url": "https://github.com/fyjvjvh555-dot/dsh-plugin-openai-relay/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
